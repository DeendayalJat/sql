-- ddl 
-- create. drop , alter
create table d(col int);
-- create table using select select(CTAS)
CREATE table ac as
select first_name,last_name from  sakila.actor;
select * from ac;
-- drop-- structure and data is deleted
drop table ac;
select* from ac;
CREATE table ac as
select first_name as f,last_name as l from  sakila.actor where actor_id between 10 and 14;
select* from ac;
-- alter make changes in structure
-- alter 
alter table ac add column salary int;
select* from ac;
alter table ac add constraint reference primary key(f);
describe ac;
alter table ac drop l;-- column drop
desc ac;
alter table ac rename  column salary to new_salary;
select* from ac;
